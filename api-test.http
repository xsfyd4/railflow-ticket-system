        client.assert(response.body.code === 3002, "期望 3002，实际 " + response.body.code);
    });
%}


### 31. 新增车站：天津南
### 返回的 data 是新车站的 id，存进变量供后面用
### ⚠️ 如果这里返回 3001，说明 TJP 已存在（上次跑到一半），
###    先手动删掉它，或者把下面三处 TJP 换成别的码
POST http://localhost:8080/api/admin/stations
Authorization: Bearer {{adminToken}}
Content-Type: application/json

{
  "stationCode": "TJP",
  "stationName": "天津南",
  "city": "天津",
  "province": "天津市",
  "pinyin": "tianjinnan",
  "pinyinAbbr": "tjn"
}

> {%
    client.test("新增成功并返回新 id", function () {
        client.assert(response.body.code === 200, "新增失败：" + response.body.msg);
        client.assert(typeof response.body.data === "number",
            "data 应该是新 id，实际是 " + typeof response.body.data);
    });
    if (response.body.code === 200) {
        client.global.set("newStationId", response.body.data);
    }
%}


### 32. 再新增一次同样的三字码
### 期望 3001（三字码已存在）
POST http://localhost:8080/api/admin/stations
Authorization: Bearer {{adminToken}}
Content-Type: application/json

{
  "stationCode": "TJP",
  "stationName": "天津南",
  "city": "天津"
}

> {%
    client.test("三字码重复应该 3001", function () {
        client.assert(response.body.code === 3001, "期望 3001，实际 " + response.body.code);
    });
%}


### 33. 修改刚新增的车站：只改名，三字码不变
### 这条专门验证「代码没变 + 能正常更新」
PUT http://localhost:8080/api/admin/stations/{{newStationId}}
Authorization: Bearer {{adminToken}}
Content-Type: application/json

{
  "stationCode": "TJP",
  "stationName": "天津南站",
  "city": "天津",
  "province": "天津市",
  "pinyin": "tianjinnan",
  "pinyinAbbr": "tjn"
}

> {%
    client.test("修改成功", function () {
        client.assert(response.body.code === 200, "期望 200，实际 " + response.body.code);
    });
%}


### 34. 再查一次，确认名字真的改了
