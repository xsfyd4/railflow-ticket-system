### 51. 管理员登录
POST http://localhost:8080/api/admin/auth/login
Content-Type: application/json

{
  "username": "admin",
  "password": "123456"
}

> {%
    client.test("管理员登录成功", function () {
        client.assert(response.body.code === 200, "登录失败：" + response.body.msg);
    });
    if (response.body.code === 200) {
        client.global.set("adminToken", response.body.data.token);
    }
%}


### 52. 查 G1001 的停站（按站序）
GET http://localhost:8080/api/admin/trains/1/stops
Authorization: Bearer {{adminToken}}

> {%
    client.test("停站列表能查到，且带站名", function () {
        client.assert(response.body.code === 200, "期望 200，实际 " + response.body.code);
        client.assert(response.body.data.length >= 2,
            "期望至少 2 站，实际 " + response.body.data.length);
        client.assert(response.body.data[0].stationName !== null,
            "stationName 是 null，检查 TrainStopMapper.xml 的 JOIN");
    });
%}


### 53. 查 G1001 的分段（按段号）
GET http://localhost:8080/api/admin/trains/1/segments
Authorization: Bearer {{adminToken}}

> {%
    client.test("分段列表能查到，且带起止站名", function () {
        client.assert(response.body.code === 200, "期望 200，实际 " + response.body.code);
        client.assert(response.body.data.length >= 1,
            "期望至少 1 段，实际 " + response.body.data.length);
        client.assert(response.body.data[0].fromStationName !== null,
            "fromStationName 是 null，检查 TrainSegmentMapper.xml 的别名");
    });
%}


### 54. ★ 原样保存停站（5 站）
### 这一步会：删旧停站 → 插新停站 → 重建分段 → 同步 train 首尾站和里程 → 删掉旧票价
PUT http://localhost:8080/api/admin/trains/1/stops
Authorization: Bearer {{adminToken}}
Content-Type: application/json

{
  "stops": [
    { "stationId": 1,  "departureTime": "07:17", "mileage": 0 },
    { "stationId": 51, "arrivalTime": "09:00", "departureTime": "09:02", "mileage": 485 },
    { "stationId": 30, "arrivalTime": "10:47", "departureTime": "10:49", "mileage": 977 },
    { "stationId": 32, "arrivalTime": "11:19", "departureTime": "11:21", "mileage": 1119 },
    { "stationId": 27, "arrivalTime": "12:18", "mileage": 1388 }
  ]
}

> {%
    client.test("保存停站成功", function () {
        client.assert(response.body.code === 200,
            "期望 200，实际 " + response.body.code + " / " + response.body.msg);
    });
%}


### 55. ★ 再查停站 —— 应该还是 5 条（不是 10 条）
GET http://localhost:8080/api/admin/trains/1/stops
Authorization: Bearer {{adminToken}}

> {%
    client.test("停站没有翻倍", function () {
        client.assert(response.body.code === 200, "期望 200，实际 " + response.body.code);
        client.assert(response.body.data.length === 5,
            "期望 5 条（先删后插），实际 " + response.body.data.length + " 条");
    });
%}


