### 27. 分页查询：第 1 页，每页 3 条
### 期望 total >= 5，records 正好 3 条
GET http://localhost:8080/api/admin/stations?page=1&size=3
Authorization: Bearer {{adminToken}}

> {%
    client.test("分页查询成功", function () {
        client.assert(response.body.code === 200, "期望 200，实际 " + response.body.code);
        client.assert(response.body.data.total >= 5,
            "期望 total >= 5，实际 " + response.body.data.total);
        client.assert(response.body.data.records.length === 3,
            "期望 3 条，实际 " + response.body.data.records.length);
    });
%}


### 28. 关键词搜索：北京
### 期望至少 1 条（北京南既匹配站名，也匹配拼音 beijingnan）
GET http://localhost:8080/api/admin/stations?keyword=北京&page=1&size=10
Authorization: Bearer {{adminToken}}

> {%
    client.test("关键词搜索有结果", function () {
        client.assert(response.body.code === 200, "期望 200，实际 " + response.body.code);
        client.assert(response.body.data.records.length >= 1,
            "期望 >= 1 条，实际 " + response.body.data.records.length);
    });
%}


### 29. 查详情：id = 1
GET http://localhost:8080/api/admin/stations/1
Authorization: Bearer {{adminToken}}

