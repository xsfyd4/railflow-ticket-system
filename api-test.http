        client.assert(response.body.data.stationName === "北京南",
            "期望 北京南，实际 " + response.body.data.stationName);
    });
%}


### 30. 查不存在的车站：id = 999
### 期望 3002（不是 200 + data:null）
GET http://localhost:8080/api/admin/stations/999
Authorization: Bearer {{adminToken}}

