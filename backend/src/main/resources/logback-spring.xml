<?xml version="1.0" encoding="UTF-8"?>
<configuration>
    <property name="LOG_DIR" value="${LOG_DIR:-logs}"/>
    <property name="LOG_PATTERN"
              value="%d{yyyy-MM-dd HH:mm:ss.SSS} %-5level [%thread] %logger{40} - %msg%n"/>

    <appender name="CONSOLE" class="ch.qos.logback.core.ConsoleAppender">
        <encoder>
            <pattern>${LOG_PATTERN}</pattern>
        </encoder>
    </appender>

    <appender name="APPLICATION_FILE"
              class="ch.qos.logback.core.rolling.RollingFileAppender">
        <file>${LOG_DIR}/application.log</file>
        <rollingPolicy class="ch.qos.logback.core.rolling.SizeAndTimeBasedRollingPolicy">
            <fileNamePattern>${LOG_DIR}/archive/application.%d{yyyy-MM-dd}.%i.log.gz</fileNamePattern>
            <maxFileSize>20MB</maxFileSize>
            <maxHistory>14</maxHistory>
            <totalSizeCap>500MB</totalSizeCap>
        </rollingPolicy>
        <encoder>
            <pattern>${LOG_PATTERN}</pattern>
        </encoder>
    </appender>

    <appender name="DATABASE_FILE"
              class="ch.qos.logback.core.rolling.RollingFileAppender">
        <file>${LOG_DIR}/database.log</file>
        <rollingPolicy class="ch.qos.logback.core.rolling.SizeAndTimeBasedRollingPolicy">
            <fileNamePattern>${LOG_DIR}/archive/database.%d{yyyy-MM-dd}.%i.log.gz</fileNamePattern>
            <maxFileSize>30MB</maxFileSize>
            <maxHistory>30</maxHistory>
            <totalSizeCap>1GB</totalSizeCap>
        </rollingPolicy>
        <encoder>
            <pattern>${LOG_PATTERN}</pattern>
        </encoder>
    </appender>

    <appender name="REDIS_FILE"
              class="ch.qos.logback.core.rolling.RollingFileAppender">
        <file>${LOG_DIR}/redis.log</file>
        <rollingPolicy class="ch.qos.logback.core.rolling.SizeAndTimeBasedRollingPolicy">
            <fileNamePattern>${LOG_DIR}/archive/redis.%d{yyyy-MM-dd}.%i.log.gz</fileNamePattern>
            <maxFileSize>20MB</maxFileSize>
            <maxHistory>30</maxHistory>
            <totalSizeCap>500MB</totalSizeCap>
        </rollingPolicy>
        <encoder>
            <pattern>${LOG_PATTERN}</pattern>
        </encoder>
    </appender>

    <appender name="MQ_FILE"
              class="ch.qos.logback.core.rolling.RollingFileAppender">
        <file>${LOG_DIR}/mq.log</file>
        <rollingPolicy class="ch.qos.logback.core.rolling.SizeAndTimeBasedRollingPolicy">
            <fileNamePattern>${LOG_DIR}/archive/mq.%d{yyyy-MM-dd}.%i.log.gz</fileNamePattern>
            <maxFileSize>20MB</maxFileSize>
            <maxHistory>30</maxHistory>
            <totalSizeCap>500MB</totalSizeCap>
        </rollingPolicy>
        <encoder>
            <pattern>${LOG_PATTERN}</pattern>
        </encoder>
    </appender>

    <!-- 业务代码日志：同时输出控制台和 application.log。 -->
    <logger name="com.ticket" level="INFO" additivity="false">
        <appender-ref ref="CONSOLE"/>
        <appender-ref ref="APPLICATION_FILE"/>
    </logger>

    <!-- MyBatis 以 Mapper 全限定类名作为日志名，因此逐包路由到 database.log。 -->
    <logger name="com.ticket.module.auth.mapper" level="DEBUG" additivity="false">
        <appender-ref ref="DATABASE_FILE"/>
    </logger>
    <logger name="com.ticket.module.passenger.mapper" level="DEBUG" additivity="false">
        <appender-ref ref="DATABASE_FILE"/>
    </logger>
    <logger name="com.ticket.module.station.mapper" level="DEBUG" additivity="false">
        <appender-ref ref="DATABASE_FILE"/>
    </logger>
    <logger name="com.ticket.module.stock.mapper" level="DEBUG" additivity="false">
        <appender-ref ref="DATABASE_FILE"/>
    </logger>
    <logger name="com.ticket.module.ticket.mapper" level="DEBUG" additivity="false">
        <appender-ref ref="DATABASE_FILE"/>
    </logger>
    <logger name="com.ticket.module.train.mapper" level="DEBUG" additivity="false">
        <appender-ref ref="DATABASE_FILE"/>
    </logger>
    <logger name="com.ticket.module.order.mapper" level="DEBUG" additivity="false">
        <appender-ref ref="DATABASE_FILE"/>
    </logger>

    <!-- 未来 Redis 操作统一进入 redis.log。 -->
    <logger name="org.springframework.data.redis" level="INFO" additivity="false">
        <appender-ref ref="REDIS_FILE"/>
    </logger>
    <logger name="io.lettuce.core" level="INFO" additivity="false">
        <appender-ref ref="REDIS_FILE"/>
    </logger>
    <logger name="redis.clients.jedis" level="INFO" additivity="false">
        <appender-ref ref="REDIS_FILE"/>
    </logger>
    <logger name="com.ticket.redis" level="INFO" additivity="false">
        <appender-ref ref="REDIS_FILE"/>
    </logger>

    <!-- RabbitMQ / AMQP 操作统一进入 mq.log。 -->
    <logger name="org.springframework.amqp" level="INFO" additivity="false">
        <appender-ref ref="MQ_FILE"/>
    </logger>
    <logger name="com.rabbitmq" level="INFO" additivity="false">
        <appender-ref ref="MQ_FILE"/>
    </logger>

    <root level="INFO">
        <appender-ref ref="CONSOLE"/>
    </root>
</configuration>
