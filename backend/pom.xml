<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>4.1.1</version>
        <relativePath/>
    </parent>

    <groupId>com.ticket</groupId>
    <artifactId>train-ticket-backend</artifactId>
    <version>0.0.1-SNAPSHOT</version>
    <name>train-ticket-backend</name>
    <description>火车票购票系统 · 后端服务</description>

    <properties>
        <java.version>17</java.version>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <jjwt.version>0.12.6</jjwt.version>
    </properties>

    <dependencies>
        <!-- Web：内嵌 Tomcat + Spring MVC，阶段 1 只需要它 -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-webmvc</artifactId>
        </dependency>

        <!--
          JDBC：Spring 自带的数据库访问能力（JdbcTemplate + HikariCP 连接池）。
          先用它接数据库，原因有两个：
          1. 零第三方兼容风险——Spring Boot 4.1.1 比较新，MyBatis-Plus 这类 ORM 需要实测；
          2. 后面的区间余票、防超卖全靠 SQL，手写能让你看清每一行在干什么。
          等对 SQL 有感觉了，再换成 MyBatis-Plus。
        -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-jdbc</artifactId>
        </dependency>

        <!-- MySQL 驱动：只负责「怎么跟 MySQL 说话」，版本由 Spring Boot 统一管理 -->
        <dependency>
            <groupId>com.mysql</groupId>
            <artifactId>mysql-connector-j</artifactId>
            <scope>runtime</scope>
        </dependency>

        <!-- 参数校验：让 @NotBlank、@Size 这些注解生效，不引它 @Valid 是空转的 -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-validation</artifactId>
        </dependency>

        <!--
          BCrypt 密码加密。
          注意只引 spring-security-crypto 这一个包，不引整个 Spring Security——
          因为我们只是要一个加密工具，不需要它那套认证框架。
          等以后真要用 Spring Security 的过滤器链，再整体引入。
        -->
        <dependency>
            <groupId>org.springframework.security</groupId>
            <artifactId>spring-security-crypto</artifactId>
        </dependency>

        <!--
          JWT 三件套，缺一不可：
          - jjwt-api    编译期用的接口（你在代码里 import 的是它）
          - jjwt-impl   运行期的实现，scope 必须是 runtime
          - jjwt-jackson 用 Jackson 做 JSON 序列化，JWT 的 payload 就是 JSON
          只引 api 会在启动时抛「Unable to find an implementation for JwtBuilder」，
          这个错很多人踩过。
        -->
        <dependency>
            <groupId>io.jsonwebtoken</groupId>
            <artifactId>jjwt-api</artifactId>
            <version>${jjwt.version}</version>
        </dependency>
        <dependency>
            <groupId>io.jsonwebtoken</groupId>
            <artifactId>jjwt-impl</artifactId>
            <version>${jjwt.version}</version>
            <scope>runtime</scope>
        </dependency>
        <dependency>
            <groupId>io.jsonwebtoken</groupId>
            <artifactId>jjwt-jackson</artifactId>
            <version>${jjwt.version}</version>
            <scope>runtime</scope>
        </dependency>

        <!-- 测试：@SpringBootTest 等 -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-webmvc-test</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
            </plugin>
        </plugins>
    </build>

    <!--
      阶段 1 只引 Web，目的是让服务能起来、能返回统一格式的 JSON。
      数据库驱动、MyBatis-Plus、JWT、接口文档这些依赖，
      等对应阶段再逐个加，每加一个都要能说清它是干什么的。
    -->
</project>
